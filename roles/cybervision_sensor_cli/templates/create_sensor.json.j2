{
    "mgmt_ip":"",
    "mgmt_netmask":"",
    "mgmt_gateway":"",
    "localmanager_username":"",
    "serial":"{{serial}}",
    "name":"{{name}}",
    "ip":"",
    "model":"iox",
    "netmask":"",
    "gw":"",
    "centerip":"",
    "mode":"{{capture_mode | default('optimal')}}",
    "rspan_capture": {{rspan|default(false)}},
{% if capture_mode is defined and capture_filter is defined and capture_mode == 'custom' and capture_filter|length  %}
    "custom": "{{capture_filter}}",
{% endif %}
{% if cybervision_sensor_cli_active_discovery and (cybervision_sensor_cli_active_discovery_interfaces | default([]) | length) %}
    "active_discovery_interfaces": [
    {% for interface in cybervision_sensor_cli_active_discovery_interfaces %}
        {
            "ip": "{{ interface.ip }}",
            "netmask": "{{ interface.netmask }}",
            "vlan": {{ interface.vlan }},
            "iface": "{{ interface.iface }}"
        },
    {% endfor %}
    ]
{% endif %}
}
